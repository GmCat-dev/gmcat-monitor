<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gmcat-monitor" path="/org/gnome/shell/extensions/gmcat-monitor/">
    <key name="theme" type="s">
      <choices><choice value="gmcat"/><choice value="plain"/></choices>
      <default>'gmcat'</default>
      <summary>Look: GmCat (mood cat) or plain</summary>
    </key>
    <key name="show-panel" type="b"><default>true</default><summary>Show in the top bar</summary></key>
    <key name="panel-numbers" type="b"><default>true</default><summary>Show numbers in the top bar</summary></key>
    <key name="show-desktop" type="b"><default>true</default><summary>Show on the desktop</summary></key>
    <key name="desktop-side" type="s">
      <choices><choice value="right"/><choice value="left"/></choices>
      <default>'right'</default>
      <summary>Which side of the desktop</summary>
    </key>
    <key name="desktop-scale" type="d"><range min="0.7" max="1.6"/><default>1.0</default><summary>Desktop panel size</summary></key>
    <key name="refresh-seconds" type="i"><range min="1" max="10"/><default>2</default><summary>Seconds between updates</summary></key>
  </schema>
</schemalist>
