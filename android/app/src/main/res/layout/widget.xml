<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp"
    android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_cat" android:layout_width="56dp" android:layout_height="56dp"
        android:src="@drawable/cat_happy" android:contentDescription="GmCat" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/w_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F4F1FF" android:textStyle="bold" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:text="Purring along." />
        <TextView android:id="@+id/w_mem" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#D9DCFF" android:textSize="13sp" android:text="Memory –" />
        <TextView android:id="@+id/w_swap" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#D9DCFF" android:textSize="13sp" android:text="Swap –" />
        <TextView android:id="@+id/w_heat" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#D9DCFF" android:textSize="13sp" android:text="Battery –" />
    </LinearLayout>
</LinearLayout>
